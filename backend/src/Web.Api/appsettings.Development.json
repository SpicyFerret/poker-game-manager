{
  "ConnectionStrings": {
    "Database": "Host=postgres;Port=5432;Database=poker-game-manager;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    // Only the secret is overridden here — issuer, audience and expiry come from
    // appsettings.json so dev and production agree on the token shape.
    "Secret": "super-duper-secret-value-that-should-be-in-user-secrets"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
