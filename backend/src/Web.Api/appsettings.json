{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Injected by the platform. In the cluster it comes from the web-api-secrets
    // Secret; locally appsettings.Development.json supplies it.
    "Database": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    // Console only by default: there is no Seq in the cluster, and without any
    // sink configured here the API produced no logs at all in production.
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    // Secret has no default on purpose — it is a secret. Startup refuses to run
    // without it (see AddAuthenticationInternal).
    "Secret": "",
    "Issuer": "poker-game-manager",
    "Audience": "poker-game-manager",
    "ExpirationInMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowInSeconds": 60
    },
    "Authentication": {
      "PermitLimit": 10,
      "WindowInSeconds": 60
    }
  }
}
