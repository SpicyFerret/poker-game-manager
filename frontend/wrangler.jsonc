{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poker-game-manager-frontend",
  "compatibility_date": "2026-08-18",
  "main": "./worker/index.ts",

  // Serves the Angular production build; falls back to index.html for
  // client-side routes so the Angular router owns unknown paths.
  "assets": {
    "directory": "./dist/frontend/browser",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },

  // API_ORIGIN and the route pattern below are placeholders. They're filled
  // in by .github/workflows/frontend-ci.yml at deploy time from the GitHub
  // Actions repository VARIABLES API_TUNNEL_HOSTNAME and FRONTEND_DOMAIN
  // (Settings -> Secrets and variables -> Actions -> Variables tab) — those
  // are the source of truth, not this file. For a local `wrangler deploy`,
  // replace the __PLACEHOLDER__ tokens by hand first (see infra/kubernetes/README.md
  // and .env.example section 5 for what API_TUNNEL_HOSTNAME should be).
  "vars": {
    "API_ORIGIN": "https://__API_TUNNEL_HOSTNAME__"
  },

  "routes": [
    { "pattern": "__FRONTEND_DOMAIN__", "custom_domain": true }
  ]
}
