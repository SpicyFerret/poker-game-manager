# poker-game-manager — secrets & variables checklist
#
# This repo does NOT load a single .env file everywhere: the .NET backend
# reads config from appsettings.json / user-secrets / env vars, OpenTofu
# reads terraform.tfvars, and Wrangler reads wrangler.jsonc + `wrangler
# secret`. There's no dotenv loader wired into any of them.
#
# This file exists as a single checklist of every secret/variable the
# project needs, with a comment on each saying what it's for, where it
# actually gets consumed, and how to obtain/generate it. Copy each value
# into the right place per its comment — do NOT expect `docker compose up`
# or `dotnet run` to pick this file up automatically.
#
# Never commit a real .env (it's gitignored) or paste real secrets into
# terraform.tfvars / wrangler.jsonc if those files are tracked by git.

# ============================================================================
# 1. Local backend dev — OPTIONAL, nothing here is required to get started
# ============================================================================
# backend/src/Web.Api/appsettings.Development.json already ships working
# defaults (Postgres creds matching docker-compose.yml, a dev JWT secret,
# CORS open to localhost:4200), so `docker compose up -d` + `dotnet run` just
# works with no setup. The vars below only matter if you want to override
# those defaults locally, e.g. via `dotnet user-secrets set "Jwt:Secret" ...`
# or by exporting them before `dotnet run` (ASP.NET Core maps env vars with
# "__" to nested config keys, e.g. Jwt__Secret -> config["Jwt:Secret"]).

# Overrides backend/src/Web.Api/appsettings*.json -> ConnectionStrings:Database.
# Default (docker-compose.yml postgres service) already works, no need to set.
ConnectionStrings__Database=Host=localhost;Port=5432;Database=poker-game-manager;Username=postgres;Password=postgres

# Overrides Jwt:Secret / Jwt:Issuer / Jwt:Audience / Jwt:ExpirationInMinutes.
# The checked-in dev value in appsettings.Development.json is fine for local
# work — only override if you specifically need a different token locally.
# Never reuse the dev value for JWT_SECRET in section 2/3 below.
Jwt__Secret=super-duper-secret-value-that-should-be-in-user-secrets
Jwt__Issuer=poker-game-manager
Jwt__Audience=poker-game-manager-clients
Jwt__ExpirationInMinutes=60

# ============================================================================
# 2. GitHub Actions — repository secrets
# ============================================================================
# Set these at: GitHub repo -> Settings -> Secrets and variables -> Actions
# -> "New repository secret". They are NOT read from this file; GitHub has
# no concept of importing a .env — you paste each value in by hand (or via
# `gh secret set NAME` from the CLI). Listed here only so nothing gets lost.
#
# GITHUB_TOKEN is NOT listed below: it's auto-provided by Actions for
# docker-publish.yml's push to ghcr.io, nothing to create.

# Used by: .github/workflows/frontend-ci.yml (Deploy to Cloudflare Workers step).
# What for: lets `wrangler deploy` publish frontend/ (Worker + static assets)
# from CI. Optional for now — the deploy step is skipped automatically when
# this secret is absent, so CI stays green without it.
# How to get it: Cloudflare dashboard -> My Profile -> API Tokens ->
# "Create Token" -> template "Edit Cloudflare Workers" (grants
# Account.Workers Scripts:Edit, scoped to your account). Copy the token once
# shown — Cloudflare won't show it again.
CLOUDFLARE_API_TOKEN=

# Used by: .github/workflows/infra-ci.yml ("plan" job, workflow_dispatch only).
# What for: lets that job write a kubeconfig and run `tofu plan`/`apply`
# against the real k3s cluster on the Raspberry Pis.
# How to get it: on a Pi, `sudo cat /etc/rancher/k3s/k3s.yaml` (k3s's default
# kubeconfig). Paste the whole YAML as the secret value, but first edit the
# `server:` line — it defaults to `https://127.0.0.1:6443`, replace that with
# the Pi's actual reachable IP/hostname on your network.
# PENDING — you said Pi credentials come later; leave unset until then.
PI_CLUSTER_KUBECONFIG=

# Used by: .github/workflows/infra-ci.yml ("plan" job) as `-var="postgres_password=..."`.
# What for: the production Postgres password OpenTofu provisions into the
# cluster (see kubernetes_secret.postgres in infra/kubernetes/main.tf). Must
# match whatever you put in infra/kubernetes/terraform.tfvars (section 3)
# when you eventually run `tofu apply` for real — GitHub Actions and your
# local tofu run must agree, since they provision the same cluster.
# How to generate: `openssl rand -base64 32`
POSTGRES_PASSWORD=

# Used by: .github/workflows/infra-ci.yml ("plan" job) as `-var="jwt_secret=..."`.
# What for: the production API's JWT signing secret, provisioned via
# kubernetes_secret.web_api -> Jwt__Secret env var on the web-api Deployment.
# Must be at least 32 chars, cryptographically random, and DIFFERENT from the
# dev placeholder in appsettings.Development.json / section 1 above. Same
# "must match terraform.tfvars" note as POSTGRES_PASSWORD applies.
# How to generate: `openssl rand -base64 48`
JWT_SECRET=

# Optional. Only needed if your Cloudflare account (the one CLOUDFLARE_API_TOKEN
# belongs to) has access to more than one account and wrangler can't infer
# which one to deploy to. Find it at: Cloudflare dashboard -> right sidebar
# of any domain/Workers overview page -> "Account ID".
CLOUDFLARE_ACCOUNT_ID=

# ============================================================================
# 3. OpenTofu — infra/kubernetes/terraform.tfvars (gitignored, not this file)
# ============================================================================
# Not actually read from .env — OpenTofu reads terraform.tfvars. Listed here
# so you have one place that explains every value it needs.
# Setup: `cp infra/kubernetes/terraform.tfvars.example infra/kubernetes/terraform.tfvars`
# then fill in real values there. Never commit that file (already gitignored).
#
#   kubeconfig_path   — local filesystem path to the same kubeconfig described
#                        under PI_CLUSTER_KUBECONFIG above, for running
#                        `tofu plan`/`apply` from your own machine instead of CI.
#   postgres_password — same value as POSTGRES_PASSWORD above.
#   jwt_secret         — same value as JWT_SECRET above.
#   image_repository   — ghcr.io/<your-github-username-or-org>/poker-game-manager-api
#                        (matches what .github/workflows/docker-publish.yml pushes to).
#   image_tag           — image tag to deploy, e.g. "latest" or a commit sha.
#
# See infra/kubernetes/README.md and terraform.tfvars.example for the full
# picture (all other variables already have sane defaults).

# ============================================================================
# 4. Cloudflare Worker — frontend/wrangler.jsonc (committed, not secret)
# ============================================================================
# Not a secret and not read from .env — it's a plain var in a tracked file,
# listed here only so you don't forget to fill it in.
#
#   API_ORIGIN — the public hostname the ALREADY-RUNNING Cloudflare Tunnel on
#                the Pis exposes for the web-api Service. The Worker proxies
#                every /api/v1/* request here. Get it from Cloudflare Zero
#                Trust dashboard -> Networks -> Tunnels -> your tunnel ->
#                Public Hostnames, where you point it at the
#                `web_api_internal_url` OpenTofu outputs (see
#                infra/kubernetes/outputs.tf). Currently a placeholder
#                ("https://REPLACE_WITH_TUNNEL_HOSTNAME") in wrangler.jsonc.
#
#   routes / custom_domain — also in wrangler.jsonc, currently commented out.
#                Uncomment and set once you decide which domain serves the
#                frontend.
#
# DOCKER_REGISTRY (docker-compose.yml, `${DOCKER_REGISTRY-}webapi`) is NOT
# listed above — it's set automatically by Visual Studio's Docker tooling
# when it publishes an image tag; nothing to configure by hand.

# ============================================================================
# 5. Cloudflare DNS records — 2 records, both in the Cloudflare dashboard's
#    DNS tab for your zone (not read from .env, not created by this repo's
#    code/CI — you create them by hand, once, when you know your domain)
# ============================================================================

# --- Record A: the page (frontend + /api/v1 proxy, same domain, via the Worker) ---
# Type:   none to create manually — a Custom Domain route is a DNS record,
#         but Cloudflare creates/manages it FOR you the first time you
#         `wrangler deploy` with a `routes: [{ pattern, custom_domain: true }]`
#         entry in wrangler.jsonc (currently commented out, see section 4).
# Name:   whatever hostname you want the app on, e.g. "poker.example.com"
#         or the bare apex "example.com". Must be a domain/zone already
#         added to your Cloudflare account.
# Target: the poker-game-manager-frontend Worker (implicit — that's what
#         "custom_domain: true" wires up).
# Action: pick the hostname, uncomment+edit `routes` in frontend/wrangler.jsonc,
#         then `wrangler deploy` (or push to main once CLOUDFLARE_API_TOKEN
#         is set — frontend-ci.yml deploys automatically).
FRONTEND_DOMAIN=poker.example.com

# --- Record B: the backend (Cloudflare Tunnel public hostname for the API) ---
# Type:   CNAME
# Name:   a subdomain you choose for the API, e.g. "api-internal.example.com".
#         Doesn't need to be pretty or user-facing — end users' browsers never
#         call it directly, only the Worker does (server-side fetch), so no
#         CORS is involved. Must differ from FRONTEND_DOMAIN.
# Target: <TUNNEL_ID>.cfargotunnel.com (your existing tunnel's ID — find it
#         in Zero Trust dashboard -> Networks -> Tunnels -> your tunnel).
# Proxy:  must stay Proxied (orange cloud) — a Tunnel's CNAME only works
#         through Cloudflare's network, not DNS-only/grey cloud.
# Action: easiest path is Zero Trust dashboard -> Networks -> Tunnels ->
#         your tunnel -> Public Hostnames -> "Add a public hostname" ->
#         set this hostname as the subdomain and point its Service at the
#         `web_api_internal_url` OpenTofu outputs (infra/kubernetes/outputs.tf,
#         e.g. http://web-api.poker-game-manager.svc.cluster.local) — this
#         creates the CNAME record for you automatically. (If your tunnel is
#         instead driven by a local cloudflared config.yml with ingress
#         rules rather than the dashboard, add the CNAME manually in the DNS
#         tab instead, then add the matching ingress rule to that config.)
#         Once created, this exact hostname (with https://) is what goes
#         into API_ORIGIN in section 4 above / frontend/wrangler.jsonc.
API_TUNNEL_HOSTNAME=api-internal.example.com
